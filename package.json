{
	"name": "obsidian-pim-integration",
	"version": "0.1.0",
	"description": "Integration for MS office or groupware (e.g. CardDav)",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node ./node_modules/typescript7/bin/tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "jest --watch",
		"proto:generate": "node node_modules/protobufjs-cli/bin/pbjs -t static-module -w commonjs -o src_generated/native_bridge.js src_native/proto/native_bridge.proto && node node_modules/protobufjs-cli/bin/pbts -o src_generated/native_bridge.d.ts src_generated/native_bridge.js",
		"lint": "eslint ."
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@agracio/edge-cs": "^1.3.7",
		"@date-fns/utc": "^2.1.1",
		"@popperjs/core": "^2.11.8",
		"@types/jest": "^30.0.0",
		"@types/lodash": "^4.17.27",
		"@types/node": "^26.6.6",
		"@types/underscore": "^1.13.0",
		"@types/vcf": "^2.0.7",
		"builtin-modules": "^5.5.0",
		"date-fns": "^4.4.0",
		"electron-edge-js": "^45.0.0",
		"esbuild": "^0.28.2",
		"esbuild-plugin-copy": "^2.1.1",
		"fp-ts": "^2.16.11",
		"ical.js": "^2.2.1",
		"jest": "^30.5.2",
		"obsidian": "^1.14.4",
		"oxide.ts": "^1.1.0",
		"protobufjs": "^8.8.1",
		"ts-jest": "^29.4.15",
		"tslib": "^2.9.1",
		"typed-vcard": "file:../typed-vcard",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript7": "npm:typescript@^7.0.2",
		"vcf": "^2.1.2",
		"workerpool": "^10.0.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"edge-js": "^27.0.0",
		"eslint": "^10.15.0",
		"globals": "^17.14.0",
		"license-checker": "^25.0.1",
		"prettier": "^3.10.1",
		"protobufjs-cli": "^2.7.1",
		"typescript-eslint": "^8.73.0"
	}
}
